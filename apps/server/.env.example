# ── O portão do Orbis ────────────────────────────────────────────────────────
# A credencial que o app pede antes de mostrar qualquer coisa.
#
# Deixe VAZIA na sua máquina: sem ela o portão fica desligado em
# desenvolvimento, que é o certo (trancar o localhost só ensina a contornar).
#
# Num servidor publicado ela é OBRIGATÓRIA. Sem ela o portão FECHA e ninguém
# entra — inclusive você. É de propósito: um servidor no ar sem credencial
# expõe o acervo e a conta de quem paga, e esse erro não pode falhar para o
# lado aberto.
#
# Nunca coloque o valor real aqui nem em qualquer arquivo versionado: este
# repositório é público, e o histórico do git guarda o que foi apagado.
ORBIS_SENHA=

# Opcional: o segredo que assina o cookie de sessão. Sem ele, um valor é
# sorteado no boot — e aí reiniciar o servidor faz todo mundo digitar a senha
# de novo. Defina para as sessões sobreviverem a um restart.
ORBIS_SEGREDO=

# Cole aqui a sua chave da Anthropic. Nunca commite este arquivo com valor real.
# No modo `queue` (o padrão) ela NÃO é usada: o servidor não chama a Anthropic,
# e sem ela nenhum token é consumido — nem por engano, nem por quem achar a URL.
ANTHROPIC_API_KEY=

# Modo de execução.
#   queue = MVP. O app registra pedidos em disco; você processa no Claude Code.
#           Não consome créditos de API.
#   api   = produção. O app chama a Anthropic direto. Consome créditos.
EXECUTION_MODE=queue

# Modelo usado na extração (loop agêntico longo). O claude-fable-5 é o modelo
# mais capaz da Anthropic (US$ 10/50 por milhão de tokens — o dobro do Opus);
# roda em esforço máximo e, se os classificadores de segurança dele recusarem
# uma requisição, o código cai sozinho para claude-opus-4-8.
ANTHROPIC_MODEL_EXTRACTOR=claude-fable-5

# Modelo usado para classificar os componentes da galeria.
ANTHROPIC_MODEL_CLASSIFIER=claude-opus-4-8

# Modelo usado para geração final de site (mesmo racional da extração).
ANTHROPIC_MODEL_GENERATOR=claude-fable-5

# Porta do servidor Hono.
PORT=8787

# Origem CORS liberada para o app web.
WEB_ORIGIN=http://localhost:5173

# Opcional: sobrescreve a raiz de dados (default: ~/design-system-ecosystem).
# DS_ECOSYSTEM_ROOT=
