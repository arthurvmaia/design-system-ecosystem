# Cole aqui a sua chave da Anthropic. Nunca commite este arquivo com valor real.
ANTHROPIC_API_KEY=

# Modo de execução.
#   queue = MVP. O app registra pedidos em disco; você processa no Claude Code.
#           Não consome créditos de API.
#   api   = produção. O app chama a Anthropic direto. Consome créditos.
EXECUTION_MODE=queue

# Modelo usado na extração (loop agêntico longo). O claude-fable-5 é o modelo
# mais capaz da Anthropic (US$ 10/50 por milhão de tokens — o dobro do Opus);
# roda em esforço máximo e, se os classificadores de segurança dele recusarem
# uma requisição, o código cai sozinho para claude-opus-4-8.
ANTHROPIC_MODEL_EXTRACTOR=claude-fable-5

# Modelo usado para classificar os componentes da galeria.
ANTHROPIC_MODEL_CLASSIFIER=claude-opus-4-8

# Modelo usado para geração final de site (mesmo racional da extração).
ANTHROPIC_MODEL_GENERATOR=claude-fable-5

# Porta do servidor Hono.
PORT=8787

# Origem CORS liberada para o app web.
WEB_ORIGIN=http://localhost:5173

# Opcional: sobrescreve a raiz de dados (default: ~/design-system-ecosystem).
# DS_ECOSYSTEM_ROOT=
