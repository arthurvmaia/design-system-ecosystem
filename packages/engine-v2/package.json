  },
  "dependencies": {
    "@ds/explorer": "workspace:*",
    "@ds/segmenter": "workspace:*",
    "@ds/shared": "workspace:*",
    "node-html-parser": "^6.1.13"
  },
  "optionalDependencies": {
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
