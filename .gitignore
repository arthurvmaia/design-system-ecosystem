node_modules
dist
.turbo
*.log
.DS_Store
.vscode
.idea
coverage
*.tsbuildinfo
apps/web/vite.config.d.ts
apps/web/vite.config.js

# Segredos. O .env.example fica versionado de propósito: é o molde, sem chave.
# Se algum destes for commitado, a chave da Anthropic vira pública no GitHub e
# precisa ser rotacionada no console — não basta apagar o arquivo depois.
.env
.env.*
!.env.example

# Zip gerado pelo EMPACOTAR.bat.
*.zip

# Dados de runtime. Ficam em ~/design-system-ecosystem, mas se alguém apontar
# o DS_ECOSYSTEM_ROOT para dentro do repo, não vão junto.
ecosystem-data/
vault/
library/
projects/
queue/
# A rota modular de código em apps/web/src/routes/projects/ NÃO é dado de
# runtime — re-inclui a pasta que o padrão `projects/` acima pegaria junto.
!apps/web/src/routes/projects/
*.db
*.db-shm
*.db-wal

# Rascunho de job (geração de site, reprodução de defeito). Sai com o prefixo
# `_tmp-` e não é código do repo: sem esta linha, um script de uma tarefa que já
# acabou derruba o `pnpm lint` de todo mundo — o biome lê este arquivo.
scripts/_tmp-*

# Prints e trace do navegador de inspeção (ferramenta de quem desenvolve, não do
# projeto): a pasta enche a cada sessão e nada no app a lê.
.playwright-mcp/
