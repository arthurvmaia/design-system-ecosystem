{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_EFFORT",
    "ANTHROPIC_MODEL_CLASSIFIER",
    "ANTHROPIC_MODEL_EXTRACTOR",
    "ANTHROPIC_MODEL_GENERATOR",
    "DS_ASSET_ALLOW_LOCAL",
    "DS_ECOSYSTEM_ROOT",
    "DS_EXPLORER_DEPTH",
    "DS_PERMITIR_API_PAGA",
    "DS_SEM_VERIFICACAO",
    "EXECUTION_MODE",
    "EXTRACTION_ENGINE",
    "NODE_ENV",
    "ORBIS_CRIATIVO_TETO_LOTE",
    "ORBIS_LOCAL",
    "ORBIS_SEGREDO",
    "ORBIS_SENHA",
    "ORBIS_SENHA_ACAO",
    "ORBIS_SENHA_VISITA",
    "ORBIS_WEB_DIST",
    "PEXELS_API_KEY",
    "PORT",
    "WEB_ORIGIN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
