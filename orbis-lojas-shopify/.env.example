# Use somente em desenvolvimento local ou testes controlados.
APP_DEMO_MODE=false

# --- Shopify: o app que instala a loja na conta do cliente ---
# Os dois valores saem do Dev Dashboard, em Configuracoes do app.
# O SECRET e senha: este arquivo nao vai para o Git e nao aparece em tela nenhuma.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# O endereco publico deste app, para a Shopify BAIXAR o ZIP do tema.
# Ela instala tema buscando uma URL, e localhost ela nao alcanca.
# Local: o endereco do tunel (https://algo.trycloudflare.com).
# Hospedado: o dominio do proprio app. Vazio = o tema fica de fora, declarado.
ORBIS_PUBLIC_URL=
