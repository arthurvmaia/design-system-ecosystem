# Use somente em desenvolvimento local ou testes controlados.
APP_DEMO_MODE=false

# --- Shopify: o app que instala a loja na conta do cliente ---
# Os dois valores saem do Dev Dashboard, em Configuracoes do app.
# O SECRET e senha: este arquivo nao vai para o Git e nao aparece em tela nenhuma.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# O endereco publico deste app, para a Shopify BAIXAR o ZIP do tema.
# Ela instala tema buscando uma URL, e localhost ela nao alcanca.
# Local: o endereco do tunel (https://algo.trycloudflare.com).
# Hospedado: o dominio do proprio app. Vazio = o tema fica de fora, declarado.
ORBIS_PUBLIC_URL=

# --- Magnific: o provedor de imagem por IA, OPCIONAL ---
# Sem esta chave a loja usa o gerador local (`lib/marca-generator.mjs`), que
# e determinístico e sempre funciona. Com ela, a loja gera imagem de verdade.
#
# O campo estava AUSENTE deste arquivo, e nao em branco. A diferenca importa:
# em branco diz "preencha"; ausente nao diz nada, e por isso ninguem conseguia
# responder se o caminho pago estava ligado ou morto.
#
# Ela e do REST, e o REST pede CHAVE. Se a sua conta Magnific entra por OAuth
# (e a deste repositorio entra), voce nao tem uma: precisa emitir no app deles,
# ou o caminho pago desta frente nao liga. Ver `packages/creative-engine/src/
# precos/tabela.ts`, secao "Por que o REST continua sem medida".
#
# O preco por imagem no REST NUNCA FOI MEDIDO -- o REST nao tem endpoint de
# simulacao. Ligar esta chave liga um gasto que o app ainda nao conta.
MAGNIFIC_API_KEY=
