{
  "name": "design-system-ecosystem",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma para engenharia reversa de sites, curadoria de componentes e geração de novos sites a partir da biblioteca curada.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @ds/indexer db:generate",
    "db:migrate": "pnpm --filter @ds/indexer db:migrate",
    "acervo:exportar": "tsx scripts/acervo-exportar.ts",
    "acervo:importar": "tsx scripts/acervo-importar.ts",
    "fila": "tsx scripts/fila.ts",
    "extrair": "tsx scripts/extrair.ts",
    "explorar": "tsx scripts/explorar.ts",
    "segmentar": "tsx scripts/segmentar.ts",
    "medir-fidelidade": "tsx scripts/medir-fidelidade.ts",
    "regiao:recompilar": "tsx scripts/regiao-recompilar.ts",
    "projeto:restaurar": "tsx scripts/projeto-restaurar.ts",
    "mascote": "tsx scripts/mascote.ts",
    "test": "node --import tsx --test \"packages/**/src/**/!(*.browser).test.ts\" \"apps/**/src/**/!(*.browser).test.ts\" \"scripts/**/*.test.ts\"",
    "testar:segmentacao": "tsx scripts/testar-segmentacao.ts",
    "fila:escolher": "tsx scripts/selecionar.ts",
    "fila:progresso": "tsx scripts/fila-progresso.ts",
    "fila:concluir": "tsx scripts/fila-concluir.ts",
    "fila:limpar": "tsx scripts/fila-limpar.ts",
    "clean": "turbo run clean",
    "comparar": "tsx scripts/comparar-motores.ts",
    "reextrair": "tsx scripts/reextrair.ts",
    "stack:backfill": "tsx scripts/stack-backfill.ts",
    "acervo:limpar-orfas": "tsx scripts/acervo-limpar-orfas.ts",
    "test:navegador": "node --import tsx --test --test-concurrency=1 \"packages/**/src/**/*.browser.test.ts\" \"apps/**/src/**/*.browser.test.ts\"",
    "test:tudo": "pnpm test && pnpm test:navegador",
    "verificar": "pnpm lint && pnpm typecheck && pnpm test && pnpm medir-fidelidade --falhar-se-piorar",
    "voz": "tsx scripts/voz-orbis.ts",
    "pagina": "tsx scripts/pagina-montar.ts",
    "publicar": "tsx scripts/publicar.ts",
    "resegmentar": "tsx scripts/resegmentar.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@ds/explorer": "workspace:^",
    "@ds/indexer": "workspace:^",
    "@ds/segmenter": "workspace:^",
    "@ds/server": "workspace:^",
    "@ds/shared": "workspace:^",
    "@ds/engine-v2": "workspace:^",
    "@ds/generator": "workspace:^"
  }
}
